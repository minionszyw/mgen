# MiniMax-H3
VIDEO_BASE_URL=https://api.minimax.cn
VIDEO_MODEL=MiniMax-H3
VIDEO_API_KEY=

# OpenAI Responses：model 是对话模型，tool model 是图片模型
# 第三方服务不支持后台模式时，命令显式加 --sync；复杂图片可加 --timeout 300
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-6-astra
IMAGE_TOOL_MODEL=gpt-image-2.5-sunburst
IMAGE_API_KEY=
